{
  "name": "aquamate",
  "version": "0.1.0",
  "private": true,
  "description": "AquaMate: a 3D desktop hydration reminder prototype",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@react-three/fiber": "^9.8.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "main": "dist-electron/main/main.js",
  "author": "AquaMate prototype",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json",
    "generate:model": "node scripts/generate-placeholder-model.mjs",
    "test": "npm run build && npm run build:mobile && npm run test:unit && node tests/e2e.mjs && node tests/mobile-e2e.mjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "generate:icons": "node scripts/generate-icons.mjs",
    "build:mobile": "vite build --mode mobile",
    "android:sync": "npm run build:mobile && cap sync android",
    "android:open": "npm run android:sync && cap open android",
    "android:run": "npm run android:sync && cap run android",
    "android:apk": "npm run android:sync && node scripts/android-apk.mjs",
    "test:mobile": "npm run build:mobile && node tests/mobile-e2e.mjs"
  },
  "build": {
    "appId": "com.aquamate.prototype",
    "productName": "AquaMate",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**/*.js",
      "dist-renderer/**/*",
      "!dist-renderer/tray/**",
      "!dist-renderer/models/README.md",
      "assets/tray/**",
      "package.json",
      "!node_modules/**"
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.healthcare-fitness",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "artifactName": "AquaMate-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "AquaMate-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1"
  }
}
